# 环境变量配置示例文件
# 复制此文件为 .env 并填入实际的值（本地开发用）；部署时在平台环境变量中填写。

# ============================================
# 站点品牌（均可选，不填则使用默认“云汇导航”）
# ============================================
VITE_SITE_TITLE=云汇导航
VITE_SITE_DESCRIPTION=精选优质网站，分类导航，一站式直达
VITE_ADMIN_TITLE=管理后台 - 云汇导航
VITE_GITHUB_URL=https://github.com/your-username/yunhui-nav

# ============================================
# 管理员界面配置（后台 /admin 需要）
# ============================================

# 管理员密钥（可以是任意字符串）
VITE_ADMIN_PASSWORD=your_admin_password_here

# 默认搜索引擎：google / baidu / bing / duckduckgo
VITE_DEFAULT_SEARCH_ENGINE=bing

# 前台访问锁：设为 true 时，访客也需输入上方密钥
VITE_OPEN_LOCK=false

# ============================================
# GitHub API 配置（后台“保存到 GitHub”需要）
# ============================================
VITE_GITHUB_TOKEN=your_github_token_here
VITE_GITHUB_OWNER=your_github_username
VITE_GITHUB_REPO=yunhui-nav
VITE_GITHUB_BRANCH=main

# ============================================
# Token 申请说明
# ============================================
# 1. 在 GitHub → Settings → Developer settings → Personal access tokens 创建
# 2. 选择 fine-grained token，仓库仅选择本项目，避免泄露影响其他工程
# 3. 权限：Contents: Read and write；Metadata: Read
# 4. 配置完成后，访问 /admin 路径即可进入管理界面
